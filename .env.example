# 遠端主機資訊
REMOTE_HOST=172.31.67.145
REMOTE_USER=ubuntu
REMOTE_PORT=2080

# 私鑰路徑 (相對於 docker-compose.yml)
SSH_KEY_PATH=./keys/key-to-aws.pem

# OpenVPN 設定檔路徑
OVPN_CONFIG_PATH=./openvpn/client.ovpn

# 本地 Proxy 監聽埠 (容器內)
PROXY_PORT=1080

# Proxy 監聽的位址 (預設 127.0.0.1：只有 SSH 通道用得到)
# 改成 0.0.0.0 就是舊版的行為：同一個 VPN 和 Docker 網路上的主機也能直接用，而且沒有帳密
PROXY_BIND=127.0.0.1
